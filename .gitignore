# Ignore video and audio files
*.mp4
*.mp3
*.avi
*.mkv
*.mov
*.wav
*.m4a
*.flac
*.ogg
*.webm
*.wmv
*.flv

# Ignore large generated outputs
*.zip
*.tar.gz
*.rar

# Keep transcribeme tracked
!transcribeme/

# Python cache artifacts
__pycache__/
*.py[cod]
*$py.class
 
# Local audio recovery 2026-11-08, never commit 
transcribeme/_recovered_20261108/ 

# Runtime logs (generated)
dashboard.log
dashboard.log.err
